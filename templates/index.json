    "custom_liquid_mT4m4w": {
      "type": "custom-liquid",
      "name": "t:sections.custom-liquid.presets.name",
      "settings": {
        "custom_liquid": "<section class=\"reviews-section\">\n  <div class=\"reviews-wrapper\">\n\n    <button class=\"review-btn prev\">&#10094;</button>\n\n    <div class=\"reviews-slider\">\n\n      <!-- Card 1 -->\n      <div class=\"review-card\">\n        <div class=\"review-header\">\n          <div class=\"avatar\">PV</div>\n          <div>\n            <h4> Manikanta</h4>\n            <span>Reviewer</span>\n          </div>\n        </div>\n\n        <div class=\"stars\">\n          ★★★★★ <span>3/5</span>\n        </div>\n\n        <div class=\"review-content\">\n          The machine feels sturdy and well-built, and the display helps me track time, calories, and distance.\n          <p>3 months ago</p>\n        </div>\n\n        <div class=\"product-info\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0986/7893/1776/files/CHG-200CHomeGym_1_58ba1b0a-d1c8-4e63-88c2-db5b8e35fbc8.jpg?v=1780423848\" alt=\"\">\n          <span>Bhasha Gym Spin Bike</span>\n        </div>\n      </div>\n\n      <!-- Card 2 -->\n      <div class=\"review-card\">\n        <div class=\"review-header\">\n          <div class=\"avatar\">VB</div>\n          <div>\n            <h4>Satya Sai</h4>\n            <span>Reviewer</span>\n          </div>\n        </div>\n\n        <div class=\"stars\">\n          ★★★★★ <span>4/5</span>\n        </div>\n\n        <div class=\"review-content\">\n          Absolutely loving my cross trainer! It's been a game-changer for my daily fitness routine.\n          <p>3 months ago</p>\n        </div>\n\n        <div class=\"product-info\">\n\n          <img src=\"https://cdn.shopify.com/s/files/1/0986/7893/1776/files/9765022af7fcb5830688d48fa4abfb87.jpg?v=1780593168 \" alt=\"\">\n          <span>Bhasha Enduro Trainer</span>\n        </div>\n      </div>\n\n      <!-- Card 3 -->\n      <div class=\"review-card\">\n        <div class=\"review-header\">\n          <div class=\"avatar\">R</div>\n          <div>\n            <h4>Suresh </h4>\n            <span>Reviewer</span>\n          </div>\n        </div>\n\n        <div class=\"stars\">\n          ★★★★★ <span>3/5</span>\n        </div>\n\n        <div class=\"review-content\">\n          Highly recommended for anyone looking for an efficient and productive treadmill.\n          <p>3 months ago</p>\n        </div>\n\n        <div class=\"product-info\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0986/7893/1776/files/treadmill-5-0hp-a-c-motorized-auto-incline-with-mp3-semi-comm--500x500.webp?v=1779978533\" alt=\"\">\n          <span>Bhasha Max Run Treadmill</span>\n        </div>\n      </div>\n\n      <!-- Card 4 -->\n      <div class=\"review-card\">\n        <div class=\"review-header\">\n          <div class=\"avatar\">A</div>\n          <div>\n            <h4>Sai</h4>\n            <span>Reviewer</span>\n          </div>\n        </div>\n\n        <div class=\"stars\">\n          ★★★★★ <span>5/5</span>\n        </div>\n\n        <div class=\"review-content\">\n          The build quality is solid and feels very durable, even with regular use.\n          <p>3 months ago</p>\n        </div>\n\n        <div class=\"product-info\">\n          <img src=\"https://cdn.shopify.com/s/files/1/0986/7893/1776/files/Gym-Fitness-Plated-Loaded-Equipment-Arm-Press-Back-Machine.avif?v=1779978619\" alt=\"\">\n          <span>Bhasha Elite Multistation Gym</span>\n        </div>\n      </div>\n\n    </div>\n\n    <button class=\"review-btn next\">&#10095;</button>\n\n  </div>\n</section>\n<style>.reviews-section{\n  padding:40px 20px;\n  background:#f7f7f7;\n}\n\n.reviews-wrapper{\n  position:relative;\n  max-width:1400px;\n  margin:auto;\n}\n\n.reviews-slider{\n  display:flex;\n  gap:20px;\n  overflow-x:auto;\n  scroll-behavior:smooth;\n  scrollbar-width:none;\n}\n\n.reviews-slider::-webkit-scrollbar{\n  display:none;\n}\n\n.review-card{\n  min-width:320px;\n  max-width:320px;\n  background:#fff;\n  border:1px solid #e5e5e5;\n  padding:20px;\n  border-radius:10px;\n  flex-shrink:0;\n}\n\n.review-header{\n  display:flex;\n  align-items:center;\n  gap:12px;\n  border-bottom:1px solid #d9d9d9;\n  padding-bottom:15px;\n}\n\n.avatar{\n  width:50px;\n  height:50px;\n  border-radius:50%;\n  background:#d8d8d8;\n  display:flex;\n  align-items:center;\n  justify-content:center;\n  font-weight:700;\n  font-size:20px;\n}\n\n.review-header h4{\n  margin:0;\n  font-size:20px;\n  color:#253746;\n}\n\n.review-header span{\n  color:#666;\n  font-size:14px;\n}\n\n.stars{\n  margin:15px 0;\n  color:#f6b100;\n  font-size:24px;\n}\n\n.stars span{\n  color:#666;\n  font-size:18px;\n  margin-left:8px;\n}\n\n.review-content{\n  background:#fafafa;\n  border-radius:8px;\n  padding:18px;\n  min-height:140px;\n  color:#444;\n  line-height:1.5;\n}\n\n.review-content p{\n  margin-top:15px;\n  color:#999;\n}\n\n.product-info{\n  margin-top:20px;\n  display:flex;\n  align-items:center;\n  gap:12px;\n}\n\n.product-info img{\n  width:55px;\n  height:auto;\n}\n\n.product-info span{\n  color:#d61f5b;\n  font-weight:600;\n}\n\n.review-btn{\n  position:absolute;\n  top:50%;\n  transform:translateY(-50%);\n  width:40px;\n  height:40px;\n  border:none;\n  background:#fff;\n  border-radius:50%;\n  cursor:pointer;\n  box-shadow:0 2px 10px rgba(0,0,0,.15);\n  z-index:5;\n  font-size:20px;\n}\n\n.prev{\n  left:-15px;\n}\n\n.next{\n  right:-15px;\n}\n\n@media(max-width:768px){\n\n  .review-card{\n    min-width:270px;\n    max-width:270px;\n    padding:15px;\n  }\n\n  .avatar{\n    width:42px;\n    height:42px;\n    font-size:16px;\n  }\n\n  .review-header h4{\n    font-size:17px;\n  }\n\n  .stars{\n    font-size:20px;\n  }\n\n  .review-content{\n    min-height:auto;\n  }\n\n  .review-btn{\n    display:none;\n  }\n}\n</style>",
