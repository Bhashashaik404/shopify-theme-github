                        </div>

                        <div class="product-title">
                            Espresso Capsules
                        </div>

                    </a>

                </div>

                <!-- Product 5 -->
                <div class="product-card capsules">

                    <a href="#">

                        <div class="product-image">

                            <img src="images/product5.png"
                                alt="Coffee">

                        </div>

                        <div class="product-title">
                            Strong Roast Capsules
                        </div>

                    </a>

                </div>

                <!-- Product 6 -->
                <div class="product-card capsules">

                    <a href="#">

                        <div class="product-image">

                            <img src="images/product6.png"
                                alt="Coffee">

                        </div>

                        <div class="product-title">
                            Premium Blend Capsules
                        </div>

