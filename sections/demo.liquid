                                alt="Machine">

                        </div>

                        <div class="product-title">
                            Gym Machines
                        </div>

                    </a>

                </div>

                <!-- Product 3 -->
                <div class="product-card capsules">

                    <a href="#">

                        <div class="product-image">

                            <img src="https://cdn.shopify.com/s/files/1/0986/7893/1776/files/Competitive-Price-Hot-Sale-Gym-Bench-Weight-Lifting-Gym-Equipment-Adjustable-Bench.avif?v=1779773186"
