                </div>

            </div>

            <!-- Next -->
            <button class="slider-arrow next">
                &#10095;
            </button>

        </div>

        <!-- Bottom Navigation -->
        <div class="bottom-controls">

            <button class="bottom-arrow left">
                &#10094;
            </button>

            <button class="bottom-arrow right">
                &#10095;
            </button>

        </div>

    </div>

</section>
<STYLE> 
    /*==========================
 GOOGLE FONT
==========================*/

@import url('https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap');

*{
margin:0;
padding:0;
box-sizing:border-box;
font-family:'Poppins',sans-serif;
}

body{
background:#f7f4ef;
overflow-x:hidden;
}

/*==========================
SECTION
==========================*/

.coffee-category-section{
position:relative;
padding:40px 0 70px;
overflow:hidden;
}

.container{
width:95%;
max-width:1500px;
margin:auto;
position:relative;
z-index:2;
}

/*==========================
BLUE BACKGROUND
==========================*/

.category-bg{
position:absolute;
top:0;
left:50%;
transform:translateX(-50%);
width:78%;
height:320px;
background:#4d84c4;
clip-path:polygon(0 0,100% 0,82% 100%,18% 100%);
z-index:0;
}

/*==========================
TITLE
==========================*/

.category-title{
color:#fff;
font-size:46px;
font-weight:700;
text-align:center;
margin-top:30px;
margin-bottom:35px;
}

/*==========================
BUTTONS
==========================*/

.category-buttons{
display:flex;
justify-content:center;
gap:18px;
margin-bottom:40px;
flex-wrap:wrap;
}

.cat-btn{

border:2px solid #4c2d18;
background:#fff;
padding:13px 38px;
font-size:18px;
border-radius:60px;
cursor:pointer;
transition:.35s;
font-weight:600;
}

.cat-btn.active{
background:#4c2d18;
color:#fff;
}

.cat-btn:hover{
background:#4c2d18;
color:#fff;
}

/*==========================
SLIDER
==========================*/

.carousel-wrapper{

display:flex;
align-items:center;
position:relative;

}

.carousel{

display:flex;
gap:30px;
overflow:hidden;
scroll-behavior:smooth;
width:100%;
padding-bottom:20px;

}

/*==========================
CARD
==========================*/

.product-card{

flex:0 0 calc(33.333% - 20px);

background:#fff;

border-radius:12px;

overflow:hidden;

transition:.35s;

}

.product-card:hover{

transform:translateY(-10px);

}

.product-card a{

text-decoration:none;
color:#222;

}

.product-image{

height:520px;

overflow:hidden;

}

.product-image img{

width:100%;
height:100%;
object-fit:cover;
display:block;
transition:.4s;

}

.product-card:hover img{

transform:scale(1.05);

}

.product-title{

padding:18px;
font-size:20px;
font-weight:600;
text-align:center;

}

/*==========================
ARROWS
==========================*/

.slider-arrow{

position:absolute;

top:45%;

transform:translateY(-50%);

width:55px;

height:55px;

border:none;

border-radius:50%;

background:#fff;

box-shadow:0 5px 20px rgba(0,0,0,.18);

cursor:pointer;

font-size:28px;

z-index:10;

transition:.3s;

}

.slider-arrow:hover{

background:#4c2d18;
color:#fff;

}

.prev{

left:-28px;

}

.next{

right:-28px;

}

/*==========================
BOTTOM BUTTONS
==========================*/

.bottom-controls{

display:flex;

justify-content:center;

gap:20px;

margin-top:30px;

}

.bottom-arrow{

width:65px;

height:42px;

border-radius:30px;

border:2px solid #333;

background:#fff;

cursor:pointer;

font-size:22px;

transition:.3s;

}

.bottom-arrow:hover{

background:#4c2d18;

color:#fff;

}

/*==========================
TABLET
==========================*/

@media(max-width:1024px){

.category-bg{

width:95%;
height:260px;

clip-path:polygon(0 0,100% 0,88% 100%,12% 100%);

}

.category-title{

font-size:38px;

}

.product-card{

flex:0 0 calc(50% - 15px);

}

.product-image{

height:430px;

}

}

/*==========================
MOBILE
==========================*/

@media(max-width:768px){

.category-bg{

width:100%;

height:220px;

clip-path:polygon(0 0,100% 0,100% 100%,0 100%);

}

.category-title{

font-size:30px;

margin-top:20px;

}

.category-buttons{

gap:12px;

}

.cat-btn{

font-size:15px;

padding:10px 20px;

}

.product-card{

flex:0 0 100%;

}

.product-image{

height:420px;

}

.slider-arrow{

display:none;

}

.bottom-controls{

margin-top:20px;

}

}

/*==========================
SMALL MOBILE
==========================*/

@media(max-width:480px){

.category-title{

font-size:24px;

}

.product-image{

height:320px;

}

.cat-btn{

width:100%;

}

.category-buttons{

flex-direction:column;

align-items:center;

}

}
</STYLE>