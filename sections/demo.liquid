<script>
(function () {
  function initGymCategorySection() {
    var sections = document.querySelectorAll(
      '.gym-category-section:not([data-gym-initialized])'
    );

    sections.forEach(function (section) {
      section.setAttribute('data-gym-initialized', 'true');

      var carousel = section.querySelector('.gym-carousel');
      var cards = Array.from(
        section.querySelectorAll('.gym-product-card')
      );
      var tabs = section.querySelectorAll('.gym-cat-btn');

      if (!carousel || !cards.length) return;

      function getScrollAmount() {
        var card = carousel.querySelector(
          '.gym-product-card:not([hidden])'
        );

        if (!card) return carousel.clientWidth;

        var styles = window.getComputedStyle(carousel);
        var gap = parseFloat(styles.columnGap) || 0;

        return card.getBoundingClientRect().width + gap;
      }

      function scrollProducts(direction) {
        carousel.scrollBy({
          left: getScrollAmount() * direction,
          behavior: 'smooth'
        });
      }

      section.querySelectorAll(
        '.gym-next, .gym-bottom-next'
      ).forEach(function (button) {
        button.addEventListener('click', function () {
          scrollProducts(1);
        });
      });

      section.querySelectorAll(
        '.gym-prev, .gym-bottom-prev'
      ).forEach(function (button) {
        button.addEventListener('click', function () {
          scrollProducts(-1);
        });
      });

      tabs.forEach(function (tab) {
        tab.addEventListener('click', function () {
          var category = tab.getAttribute('data-category');

          tabs.forEach(function (item) {
            var active = item === tab;
            item.classList.toggle('active', active);
            item.setAttribute('aria-pressed', String(active));
          });

          cards.forEach(function (card) {
            card.hidden =
              card.getAttribute('data-category') !== category;
          });

          carousel.scrollTo({
            left: 0,
            behavior: 'smooth'
          });
        });

        tab.setAttribute(
          'aria-pressed',
          String(tab.classList.contains('active'))
        );
      });

      /* Keep category filtering compatible with the card layout. */
      var style = document.createElement('style');
      style.textContent =
        '.gym-category-section .gym-product-card[hidden]{display:none!important}';
      section.appendChild(style);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initGymCategorySection
    );
  } else {
    initGymCategorySection();
  }
})();
</script>
